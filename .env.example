# Copy to .env and use: docker compose --env-file .env up --build

# Google OAuth Web client id (API validation + baked into frontend image at build time).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated institutional domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=your-school.edu

# Comma-separated emails that receive the Teacher role on first sign-in.
TEACHER_BOOTSTRAP_EMAILS=teacher1@your-school.edu,teacher2@your-school.edu
