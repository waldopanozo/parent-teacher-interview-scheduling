# Copy to .env and use: docker compose --env-file .env up --build
#
# --- API hosting (optional) ---
# You do NOT need to set this for local Docker: docker-compose already defaults the API to Development.
# Add the line below only if you want to override (e.g. Production — demo accounts will NOT be seeded).
# ASPNETCORE_ENVIRONMENT=Development
#
# --- Development demo accounts (email + password) ---
# Password for all: password
#   demo-parent@example.com   → Parent
#   demo-teacher@example.com  → Teacher
#   demo-director@example.com → Director
# Seeded when (not Production) and: Development environment OR Seed__DemoUsers=true (Compose default).
# Includes demo teacher offering (Algebra I / MATH, Mon–Fri afternoons) when demo teacher has no offerings yet.
# Never seeded if ASPNETCORE_ENVIRONMENT=Production. Check API logs: "Seeded N demo users" or "Skipping demo password users".
# Optional override: SEED_DEMO_USERS=false

# Google OAuth Web client id (API validation + baked into frontend image at build time).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated allowed email domains (e.g. northview.edu). Leave empty to allow any verified Google account
# (typical when the school only uses personal Gmail). If non-empty, only those domains match unless you set
# ALLOW_PERSONAL_GOOGLE_EMAILS=true (then @gmail.com / @googlemail.com are also accepted).
ALLOWED_EMAIL_DOMAINS=

# true = when ALLOWED_EMAIL_DOMAINS is set, also allow @gmail.com and @googlemail.com (mixed school).
ALLOW_PERSONAL_GOOGLE_EMAILS=true

# Comma-separated emails that receive the Teacher role on first sign-in (any domain you allow above).
TEACHER_BOOTSTRAP_EMAILS=teacher@example.com,other.teacher@gmail.com

# Comma-separated emails that receive the Director (school manager) role on first sign-in.
DIRECTOR_BOOTSTRAP_EMAILS=director@example.com
