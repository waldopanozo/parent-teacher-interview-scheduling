# Google OAuth (Web application client) used to validate Google ID tokens.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated institutional domains allowed to sign in (matches Google Workspace hosted domain or email suffix).
ALLOWED_EMAIL_DOMAINS=your-school.edu

# Comma-separated emails that should receive the Teacher role on first successful sign-in.
TEACHER_BOOTSTRAP_EMAILS=teacher1@your-school.edu,teacher2@your-school.edu
