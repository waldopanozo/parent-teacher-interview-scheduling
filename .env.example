# Copy to .env and use: docker compose --env-file .env up --build

# Google OAuth Web client id (API validation + baked into frontend image at build time).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated allowed email domains (e.g. northview.edu). Leave empty to allow any verified Google account
# (typical when the school only uses personal Gmail). If non-empty, only those domains match unless you set
# ALLOW_PERSONAL_GOOGLE_EMAILS=true (then @gmail.com / @googlemail.com are also accepted).
ALLOWED_EMAIL_DOMAINS=

# true = when ALLOWED_EMAIL_DOMAINS is set, also allow @gmail.com and @googlemail.com (mixed school).
ALLOW_PERSONAL_GOOGLE_EMAILS=true

# Comma-separated emails that receive the Teacher role on first sign-in (any domain you allow above).
TEACHER_BOOTSTRAP_EMAILS=teacher@example.com,other.teacher@gmail.com
